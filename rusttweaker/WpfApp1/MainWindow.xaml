<Window
	x:Class="WpfApp1.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
	xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="RustTweaker"
	Height="900"
	Width="1440"
	WindowStyle="None"
	AllowsTransparency="True"
	Background="#00FFFFFF"
	MinWidth="1450"
	MinHeight="800"
	WindowStartupLocation="CenterScreen"
	xmlns:wpfapp1="clr-namespace:WpfApp1">
	<WindowChrome.WindowChrome>
		<WindowChrome
			CaptionHeight="0"
			ResizeBorderThickness="6"
			GlassFrameThickness="0"
			UseAeroCaptionButtons="False" />
	</WindowChrome.WindowChrome>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				x:Key="ButtonHoverStyle"
				TargetType="{x:Type Button}">
				<Setter
					Property="Width"
					Value="42" />
				<Setter
					Property="Height"
					Value="32" />
				<Setter
					Property="BorderThickness"
					Value="0" />
				<Setter
					Property="Background"
					Value="#111115" />
				<Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Border
								x:Name="border"
								Background="{TemplateBinding Control.Background}"
								CornerRadius="0"
								SnapsToDevicePixels="True">
								<ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="border"
										Property="Border.Background"
										Value="#E54D2E" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="border"
										Property="Border.Background"
										Value="#B22609" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				x:Key="ButtonHoverStyleLeft"
				TargetType="{x:Type Button}">
				<Setter
					Property="Width"
					Value="42" />
				<Setter
					Property="Height"
					Value="32" />
				<Setter
					Property="BorderThickness"
					Value="0" />
				<Setter
					Property="Background"
					Value="#111115" />
				<Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Border
								x:Name="border"
								Background="{TemplateBinding Control.Background}"
								CornerRadius="12, 0, 0, 12"
								SnapsToDevicePixels="True">
								<ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="border"
										Property="Border.Background"
										Value="#E54D2E" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="border"
										Property="Border.Background"
										Value="#B22609" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				x:Key="ButtonHoverStyleRight"
				TargetType="{x:Type Button}">
				<Setter
					Property="Width"
					Value="42" />
				<Setter
					Property="Height"
					Value="32" />
				<Setter
					Property="BorderThickness"
					Value="0" />
				<Setter
					Property="Background"
					Value="#111115" />
				<Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Border
								x:Name="border"
								Background="{TemplateBinding Control.Background}"
								CornerRadius="0,12, 12,0"
								SnapsToDevicePixels="True">
								<ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="border"
										Property="Border.Background"
										Value="#E54D2E" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="border"
										Property="Border.Background"
										Value="#B22609" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Border
		x:Name="RootBorder"
		Background="#09090D"
		CornerRadius="28"
		BorderBrush="#09090D"
		BorderThickness="1"
		SnapsToDevicePixels="True"
		ClipToBounds="True">
		<Grid
			ClipToBounds="True">
			<!--Присоединяемое событие 'Invoke'.-->
			<Border
				Height="64"
				VerticalAlignment="Top"
				Padding="16,0,16,0">
				<Grid>
					<StackPanel
						Orientation="Horizontal"
						Width="Auto">
						<Image
							Source="Assets/logo.png"
							Height="20"
							Stretch="Uniform"
							Margin="4,0,8,0" />
						<TextBlock
							Text="RustTweaker"
							FontSize="16"
							FontFamily="./content/#Geologica SemiBold"
							VerticalAlignment="Center"
							Foreground="#FFFFFFFF"
							Opacity="0.6" />
					</StackPanel>
					<!--Присоединяемое событие 'Invoke'.-->
					<Border
						Grid.Column="1"
						Background="#00FFFFFF" />
					<StackPanel
						Orientation="Horizontal"
						HorizontalAlignment="Right">
						<!--Присоединяемое событие 'Invoke'.-->
						<Button
							Tag="https://www.youtube.com/@woodcockrust"
							Margin="0,0,2,0"
							Style="{StaticResource ButtonHoverStyleLeft}">
							<Image
								Source="Assets/yt.png"
								Width="16"
								Height="16"
								VerticalAlignment="Center"
								HorizontalAlignment="Center" />
						</Button>
						<!--Присоединяемое событие 'Invoke'.-->
						<Button
							Tag="https://t.me/RustTweaker"
							Margin="0,0,2,0"
							Style="{StaticResource ButtonHoverStyle}">
							<Image
								Source="Assets/tg.png"
								Width="16"
								Height="16"
								VerticalAlignment="Center"
								HorizontalAlignment="Center" />
						</Button>
						<!--Присоединяемое событие 'Invoke'.-->
						<Button
							Tag="https://t.me/tweaker_helpbot"
							Margin="0,0,16,0"
							Style="{StaticResource ButtonHoverStyleRight}">
							<Image
								Source="Assets/faq.png"
								Width="16"
								Height="16"
								VerticalAlignment="Center"
								HorizontalAlignment="Center" />
						</Button>
						<!--Присоединяемое событие 'Invoke'.-->
						<Button
							Margin="0,0,2,0"
							Style="{StaticResource ButtonHoverStyleLeft}">
							<Image
								Source="Assets/3.png"
								Width="16"
								Height="16"
								VerticalAlignment="Center"
								HorizontalAlignment="Center" />
						</Button>
						<!--Присоединяемое событие 'Invoke'.-->
						<Button
							Margin="0,0,2,0"
							Style="{StaticResource ButtonHoverStyle}">
							<Image
								Source="Assets/2.png"
								Width="16"
								Height="16"
								VerticalAlignment="Center"
								HorizontalAlignment="Center" />
						</Button>
						<!--Присоединяемое событие 'Invoke'.-->
						<Button
							Margin="0,0,0,0"
							ForceCursor="False"
							Style="{StaticResource ButtonHoverStyleRight}">
							<Image
								Source="Assets/1.png"
								Width="16"
								Height="16"
								VerticalAlignment="Center"
								HorizontalAlignment="Center" />
						</Button>
					</StackPanel>
				</Grid>
			</Border>
			<wv2:WebView2
				x:Name="webView"
				Margin="16,64,16,16" />
		</Grid>
	</Border>
</Window>
